{
  "name": "proshop",
  "version": "1.0.0",
  "description": "eCommerce application built with the mern stack",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "server": "tsx watch backend/server.ts",
    "client": "npm start --prefix frontend",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "data:import": "tsx backend/seeder.ts",
    "data:destroy": "tsx backend/seeder.ts -d",
    "typecheck": "tsc -p backend --noEmit && npm run typecheck --prefix frontend",
    "build:server": "tsc -p backend",
    "build": "npm install --include=dev && npm run build:server && npm install --prefix frontend && npm run build --prefix frontend"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grmbyrn/proshop.git"
  },
  "author": "Graeme Byrne",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/grmbyrn/proshop/issues"
  },
  "homepage": "https://github.com/grmbyrn/proshop#readme",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "colors": "^1.4.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4",
    "multer": "^2.5.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
